# Backend
LEGAL_OWNER_NAME=SRIYAN
PORT=4000
APP_ID=local-dev-app
APP_SECRET=local-dev-secret-change-me
CHAIN_SIGNING_SECRET=local-dev-chain-secret-change-me
OWNER_UNION_ID=local-dev-user
DEV_AUTH_ENABLED=false
FRONTEND_ORIGIN=http://localhost:5175,http://127.0.0.1:5175

# Capacity and safety limits
HOST=127.0.0.1
BODY_LIMIT_BYTES=10485760
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=2000
REALTIME_MAX_CLIENTS=500
REALTIME_KEEPALIVE_MS=25000
LEDGER_LOCK_TIMEOUT_SECONDS=5
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false
REDIS_HEALTH_TIMEOUT_MS=2000
ROUTER_INTEGRATION_SECRET=local-router-secret-change-me
ROUTER_REQUIRE_REQUEST_SIGNATURE=false
ROUTER_SIGNATURE_TOLERANCE_SECONDS=300
PAYMENT_CONNECTIVITY_MAX_SECONDS=300
PAYMENT_CONNECTIVITY_BANDWIDTH_MBPS=2
PAYMENT_CONNECTIVITY_ALLOWED_HOSTS=

# Database
# Use this URL with database/docker-compose.yml.
DATABASE_URL=mysql://sriyan:sriyan@127.0.0.1:3307/sriyan
DATABASE_MODE=default

# Frontend settings. Leave VITE_API_URL blank to use the Vite /api proxy.
VITE_API_URL=
VITE_APP_ID=local-dev-app
VITE_SRIYAN_AUTH_URL=http://localhost:4000

# Backend OAuth settings. Required in production when using SRIYAN OAuth.
SRIYAN_AUTH_URL=
SRIYAN_OPEN_URL=

# Optional first-party social login. Google/Apple buttons become live when set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Optional password-reset email webhook. In local dev the reset token is returned
# in the API response when this is blank.
AUTH_EMAIL_WEBHOOK_URL=

# Real payment gateway. Pick exactly one provider for PAYMENT_GATEWAY_PROVIDER.
PAYMENT_GATEWAY_PROVIDER=razorpay
PUBLIC_APP_URL=http://127.0.0.1:5175
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_ENVIRONMENT=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_OAUTH_URL=
PHONEPE_PAY_URL=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
