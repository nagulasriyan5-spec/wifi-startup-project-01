# Legal / ownership
LEGAL_OWNER_NAME=SRIYAN

# Runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
FRONTEND_ORIGIN=https://your-domain.com
DEV_AUTH_ENABLED=false

# Application secrets. Use long random values in production.
APP_ID=sriyan-production
APP_SECRET=change-this-app-secret
CHAIN_SIGNING_SECRET=change-this-ledger-signing-secret
OWNER_UNION_ID=replace-with-owner-union-id

# MySQL container bootstrap
MYSQL_DATABASE=sriyan
MYSQL_USER=sriyan
MYSQL_PASSWORD=change-this-mysql-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Backend database connection
DATABASE_URL=mysql://sriyan:change-this-mysql-password@mysql:3306/sriyan
DATABASE_MODE=default
DB_CONNECTION_LIMIT=50
DB_MAX_IDLE=20
DB_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=2000
DB_CONNECT_TIMEOUT_MS=10000

# API and realtime pressure limits
BODY_LIMIT_BYTES=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
REALTIME_MAX_CLIENTS=5000
REALTIME_KEEPALIVE_MS=25000
LEDGER_LOCK_TIMEOUT_SECONDS=5
REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=true
REDIS_HEALTH_TIMEOUT_MS=2000
ROUTER_INTEGRATION_SECRET=change-this-router-integration-secret
ROUTER_REQUIRE_REQUEST_SIGNATURE=true
ROUTER_SIGNATURE_TOLERANCE_SECONDS=300
PAYMENT_CONNECTIVITY_MAX_SECONDS=300
PAYMENT_CONNECTIVITY_BANDWIDTH_MBPS=2
PAYMENT_CONNECTIVITY_ALLOWED_HOSTS=

# Frontend build/runtime settings
VITE_API_URL=
VITE_APP_ID=sriyan-production
VITE_SRIYAN_AUTH_URL=https://your-domain.com

# Required when using SRIYAN OAuth.
SRIYAN_AUTH_URL=https://your-domain.com
SRIYAN_OPEN_URL=https://your-domain.com

# Optional first-party social login. Use real OAuth credentials from Google and Apple.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# Password-reset email delivery webhook. Configure to send reset links in production.
AUTH_EMAIL_WEBHOOK_URL=

# Real payment gateway. Pick exactly one provider for PAYMENT_GATEWAY_PROVIDER.
PAYMENT_GATEWAY_PROVIDER=razorpay
PUBLIC_APP_URL=https://your-domain.com
RAZORPAY_KEY_ID=change-this-razorpay-key-id
RAZORPAY_KEY_SECRET=change-this-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=change-this-razorpay-webhook-secret
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_ENVIRONMENT=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=production
PHONEPE_OAUTH_URL=
PHONEPE_PAY_URL=
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
